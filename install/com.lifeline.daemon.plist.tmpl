<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by install.sh with @@ placeholders replaced. Loaded via launchctl. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lifeline.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>@@NODE@@</string>
    <string>@@LIFELINE_DIR@@/dist/daemon/index.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LIFELINE_HOME</key>
    <string>@@LIFELINE_HOME@@</string>
    <key>PATH</key>
    <string>@@PATH@@</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <!-- launchd hands agents a low file-descriptor ceiling; raise it so a large
       ~/.claude/projects tree can never starve the daemon of handles. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
  <key>HardResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@@LIFELINE_HOME@@/logs/daemon.out.log</string>
  <key>StandardErrorPath</key>
  <string>@@LIFELINE_HOME@@/logs/daemon.err.log</string>
</dict>
</plist>
